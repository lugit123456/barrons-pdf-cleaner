# LLM API 访问密钥；请替换为你自己的密钥，不要提交真实密钥。
OPENAI_API_KEY=your_api_key_here
# OpenAI 兼容 API 的基础地址。
OPENAI_API_URL=https://your-openai-compatible-endpoint/v1
# 主模型名称，例如 gpt-5、gpt-4o 或中转站支持的模型名。
OPENAI_MODEL=gpt-4o
# 单次 LLM 请求超时时间，单位为秒。
OPENAI_TIMEOUT=180
# 主模型失败时使用的备用模型，多个模型用英文逗号分隔。
OPENAI_FALLBACK_MODELS=
# 额外传给 OpenAI 兼容接口的 JSON 参数。
OPENAI_EXTRA_BODY=
# 是否启用 MiniMax reasoning split 兼容参数。
MINIMAX_REASONING_SPLIT=true
# 是否关闭 MiniMax 的思考输出，避免 JSON 前出现 <think> 内容。
MINIMAX_DISABLE_THINKING=true
# 是否请求 JSON mode；不支持时程序会自动重试并移除该参数。
LLM_JSON_MODE=true
# 是否跳过已经失败的模型；false 表示继续尝试备用模型。
LLM_SKIP_FAILED_MODELS=false
# 通用 LLM 调用失败后的最大重试次数。
LLM_MAX_RETRIES=3
# 整个进程最多同时发送多少个 LLM HTTP 请求；中转站限流时建议设为 2。
LLM_MAX_CONCURRENT_REQUESTS=3
# 同一页或混合 PDF 最多同时编译多少篇文章，最终仍受全局请求上限约束。
LLM_ARTICLE_WORKERS=3
# 扫描页文章边界识别的最大输出 token 数。
LLM_MAX_TOKENS=3000
# 是否启用页级 JSON 缓存。
ENABLE_JSON_CACHE=true
# 扫描 PDF 是否必须由 LLM 拆成文章；true 时不会退回“一页一篇”。
REQUIRE_LLM_ARTICLE_SPLIT=true
# 是否调用 LLM 逐段翻译正文并独立生成中文标题和解读。
LLM_COMPILE_ARTICLES=true
# 单篇逐段翻译请求的最大输出 token 数。
LLM_COMPILE_MAX_TOKENS=14000
# 普通短文章翻译时的最小输出 token 数；程序会根据正文长度在最小值和最大值之间动态调整。
LLM_COMPILE_MIN_TOKENS=8000
# 单篇中文解读请求的最小输出 token 数；程序也会根据解读字数要求自动提高。
LLM_SUMMARY_MAX_TOKENS=3000
# 页面抓取期间首次编译单篇文章的请求次数；失败后交给延迟队列，建议保持 1。
LLM_COMPILE_INITIAL_RETRIES=1
# 页面全部抓取结束后，是否重新处理编译失败的文章；不会重复 OCR、拆页和图片提取。
DEFERRED_COMPILE_ENABLED=true
# 延迟编译最多执行几轮。
DEFERRED_COMPILE_ROUNDS=3
# 每轮对单篇文章请求 LLM 的次数；建议保持 1，由轮次负责退避。
DEFERRED_COMPILE_RETRIES_PER_ROUND=1
# 延迟编译并发数；默认 2，若中转站限流严重可改为 1。
DEFERRED_COMPILE_WORKERS=2
# 延迟补编译成功后是否立即继续生成 glossary；关闭可优先完成翻译，之后用 enrich_glossary.py 回填。
DEFERRED_COMPILE_GLOSSARY_ENABLED=false
# 第一轮延迟编译前的等待秒数，后续按 1、3、6 倍退避。
DEFERRED_COMPILE_COOLDOWN_SECONDS=30
# 是否严格检查中文解读的长度、段落数量和长句；翻译段落始终要求与英文一一对应。
STRICT_LLM_COMPILE=true
# 正常报道正文的最低英文词数；低于此值会尝试修复或丢弃。
MIN_ARTICLE_WORDS=80
# 短正文修复任务的最大输出 token 数。
LLM_REPAIR_MAX_TOKENS=3000
# 短正文修复失败后的重试次数。
LLM_REPAIR_MAX_RETRIES=3
# 同页文章碎片完整性复核的最大输出 token 数。
LLM_FRAGMENT_REVIEW_MAX_TOKENS=1800
# 同页文章碎片完整性复核失败后的重试次数。
LLM_FRAGMENT_REVIEW_MAX_RETRIES=2
# 原生文字层 PDF 的文章拆分最大输出 token 数。
LLM_NATIVE_SPLIT_MAX_TOKENS=12000
# Barron's 单一大标题版面可优先使用本地坐标拆分；默认先让 LLM 判断，减少广告误收。
BARRONS_LOCAL_SPLIT_FIRST=false
# 判断 PDF 是否包含可用文字层的最小字符数。
NATIVE_PAGE_MIN_CHARS=200
# 判断 PDF 是否包含可用文字层的最小英文单词数。
NATIVE_PAGE_MIN_WORDS=40
# 原生文字层中允许的最小字母数字比例。
NATIVE_MIN_ALNUM_RATIO=0.55
# 原生文字层允许的最大替换字符比例。
NATIVE_MAX_REPLACEMENT_RATIO=0.02
# 原生 PDF 图片提取的最小面积比例。
NATIVE_IMAGE_MIN_AREA_RATIO=0.0025
# 原生 PDF 提取图片的最小宽度，单位为 PDF point。
NATIVE_IMAGE_MIN_WIDTH=45
# 原生 PDF 提取图片的最小高度，单位为 PDF point。
NATIVE_IMAGE_MIN_HEIGHT=30
# 原生文字本地回退规则判定标题的最小字号。
NATIVE_LOCAL_TITLE_MIN_SIZE=11
# 原生文字解析失败时是否启用 MinerU/其他本地解析回退。
HYBRID_ENABLE_MINERU_FALLBACK=true
# 混合 PDF 回退解析时的渲染 DPI。
HYBRID_FALLBACK_DPI=180
# 原生图片对象损坏时，按页面区域栅格化图片所使用的 DPI。
NATIVE_IMAGE_FALLBACK_DPI=180
# 扫描 PDF 同时处理的页面数；默认 2 可兼顾 OCR 速度和内存占用。
PDF_PAGE_WORKERS=2
# 扫描 PDF 逐页渲染 DPI；提高会改善 OCR 清晰度，但会增加耗时和内存。
SCANNED_RENDER_DPI=150
# 是否在解析前检查并自动修复 xref/page tree 损坏的 PDF。
PDF_AUTO_REPAIR=true
# 修复副本缓存目录；副本按源文件哈希复用，不会覆盖原 PDF。
PDF_REPAIR_CACHE_DIR=./.state/repaired_pdfs
# qpdf/Ghostscript 修复单个 PDF 的最长等待时间，单位为秒。
PDF_REPAIR_TIMEOUT=600
# 默认输入 PDF 目录；自动轮询时以 watch_config.json 为准。
INPUT_DIR=./input_pdfs
# 默认输出目录；自动轮询时也会读取 watch_config.json 的设置。
OUTPUT_DIR=./output_results
# MinerU 的模型模式。
MINERU_MODEL_MODE=lite
# 是否使用 MinerU 内置模型。
MINERU_USE_INSIDE_MODEL=true
# 是否打印 MinerU 的逐页处理进度。
MINERU_SHOW_PROGRESS=true
# 已处理 PDF 的 SQLite 状态库路径，用于跳过重复抓取。
STATE_DB_PATH=./.state/processed_pdfs.sqlite3
# 是否让 LLM 分析文章关联的图片和图表。
LLM_ANALYZE_ARTICLE_IMAGES=true
# 专用视觉模型；留空时回退使用 OPENAI_MODEL。
OPENAI_VISION_MODEL=
# OCR 为空时整页视觉文章识别的最大输出 token 数。
VISION_LLM_MAX_TOKENS=6000
# OCR 为空时整页视觉文章识别失败后的重试次数。
VISION_LLM_MAX_RETRIES=3
# 图片/图表分析的最大输出 token 数。
LLM_IMAGE_ANALYSIS_MAX_TOKENS=2400
# 图片/图表分析失败时的重试次数。
LLM_IMAGE_ANALYSIS_MAX_RETRIES=2
# 每篇文章最多发送给视觉模型的图片数量。
LLM_MAX_IMAGES_PER_ARTICLE=6
# 是否为中英文对照中的英文专业术语、人名、机构和书名生成中文解释。
LLM_GLOSSARY_ENABLED=true
# 术语解释专用模型；留空时回退使用 OPENAI_MODEL。
OPENAI_GLOSSARY_MODEL=
# 术语模型失败时使用的备用模型；留空时使用 OPENAI_FALLBACK_MODELS。
OPENAI_GLOSSARY_MODEL_FALLBACK_MODELS=
# 每篇文章最多标注多少个术语，避免正文下划线过密。
LLM_GLOSSARY_MAX_TERMS=12
# 中文译文中最多提取多少个英文候选；候选会作为 LLM 必答项，过大可能增加耗时。
LLM_GLOSSARY_MAX_ZH_CANDIDATES=16
# 单篇文章发送给术语模型的最大中英文总字符数。
LLM_GLOSSARY_MAX_INPUT_CHARS=24000
# 单篇术语解释请求的最大输出 token 数。
LLM_GLOSSARY_MAX_TOKENS=5000
# 术语解释请求失败后的重试次数。
LLM_GLOSSARY_MAX_RETRIES=2
# 回填已有 database.js 时同时处理的文章数，最终仍受 LLM_MAX_CONCURRENT_REQUESTS 限制。
LLM_GLOSSARY_WORKERS=3
# Netlify 访问令牌；仅用于 scripts/publish.py，不要提交真实值。
NETLIFY_AUTH_TOKEN=
# Netlify Site ID；仅用于 scripts/publish.py。
NETLIFY_SITE_ID=
